---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import { Content } from '../../content/notes/qr-code.md';
---

<BaseLayout
  title="深度探索二维码及其应用 — Yun Lambert"
  description="2019 年二维码原理、纠错编码与艺术二维码实现笔记历史归档。"
