<canvas class="starfield" data-starfield aria-hidden="true"></canvas>

<script>
  const canvas = document.querySelector<HTMLCanvasElement>('[data-starfield]');
  const hero = canvas?.closest<HTMLElement>('.hero, .domain-hero');

  if (canvas && hero) {
    const context = canvas.getContext('2d', { alpha: true });
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const pointer = { x: 0, y: 0, targetX: 0, targetY: 0 };
    let width = 0;
    let height = 0;
    let frame = 0;
    let active = true;
    let stars: Star[] = [];

    type Star = {
      x: number;
      y: number;
      vx: number;
      vy: number;
      radius: number;
      alpha: number;
      depth: number;
    };

    const cssColor = (name: string, fallback: string) => {
      const value = getComputedStyle(document.documentElement).getPropertyValue(name).trim();
      return value || fallback;
    };

    const makeStars = () => {
      const count = width < 640 ? 42 : Math.min(92, Math.round(width / 16));
      stars = Array.from({ length: count }, () => ({
        x: Math.random() * width,
        y: Math.random() * height,
        vx: (Math.random() - 0.5) * 0.08,
        vy: (Math.random() - 0.5) * 0.06,
        radius: 0.45 + Math.random() * 1.35,
        alpha: 0.24 + Math.random() * 0.68,
        depth: 0.25 + Math.random() * 0.75
      }));
    };

    const resize = () => {
      const rect = hero.getBoundingClientRect();
      const dpr = Math.min(window.devicePixelRatio || 1, 1.75);
      width = Math.max(1, rect.width);
      height = Math.max(1, rect.height);
      canvas.width = Math.round(width * dpr);
      canvas.height = Math.round(height * dpr);
      canvas.style.width = `${width}px`;
      canvas.style.height = `${height}px`;
      context?.setTransform(dpr, 0, 0, dpr, 0, 0);
      makeStars();
      draw(false);
    };

    const draw = (advance = true) => {
      if (!context) return;
      const starColor = cssColor('--star-rgb', '202, 244, 255');
      const lineColor = cssColor('--star-line-rgb', '82, 200, 221');
      context.clearRect(0, 0, width, height);

      pointer.x += (pointer.targetX - pointer.x) * 0.045;
      pointer.y += (pointer.targetY - pointer.y) * 0.045;

      if (advance && !reducedMotion.matches) {
        stars.forEach((star) => {
          star.x += star.vx;
          star.y += star.vy;
          if (star.x < -12) star.x = width + 12;
          if (star.x > width + 12) star.x = -12;
          if (star.y < -12) star.y = height + 12;
          if (star.y > height + 12) star.y = -12;
        });
      }

      const positions = stars.map((star) => ({
        x: star.x + pointer.x * star.depth * 12,
        y: star.y + pointer.y * star.depth * 8
      }));

      for (let i = 0; i < stars.length; i += 1) {
        for (let j = i + 1; j < stars.length; j += 1) {
          const dx = positions[i].x - positions[j].x;
          const dy = positions[i].y - positions[j].y;
          const distance = Math.sqrt(dx * dx + dy * dy);
          if (distance < 118) {
            context.beginPath();
            context.moveTo(positions[i].x, positions[i].y);
            context.lineTo(positions[j].x, positions[j].y);
            context.strokeStyle = `rgba(${lineColor}, ${(1 - distance / 118) * 0.14})`;
            context.lineWidth = 0.65;
            context.stroke();
          }
        }
      }

      stars.forEach((star, index) => {
        const position = positions[index];
        context.beginPath();
        context.arc(position.x, position.y, star.radius, 0, Math.PI * 2);
        context.fillStyle = `rgba(${starColor}, ${star.alpha})`;
        context.fill();
      });
    };

    const tick = () => {
      draw();
      if (active && !reducedMotion.matches) frame = window.requestAnimationFrame(tick);
    };

    const start = () => {
      window.cancelAnimationFrame(frame);
      if (!reducedMotion.matches && active) frame = window.requestAnimationFrame(tick);
      else draw(false);
    };

    hero.addEventListener('pointermove', (event) => {
      const rect = hero.getBoundingClientRect();
      pointer.targetX = (event.clientX - rect.left) / rect.width - 0.5;
      pointer.targetY = (event.clientY - rect.top) / rect.height - 0.5;
    }, { passive: true });

    hero.addEventListener('pointerleave', () => {
      pointer.targetX = 0;
      pointer.targetY = 0;
    }, { passive: true });

    document.addEventListener('visibilitychange', () => {
      active = !document.hidden;
      start();
    });
    reducedMotion.addEventListener('change', start);

    const observer = new ResizeObserver(resize);
    observer.observe(hero);
    resize();
    start();
  }
</script>
