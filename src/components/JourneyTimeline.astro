---
import { timeline } from '../data/site';
---

<ol class="journey-timeline">
  {timeline.map((item, index) => (
    <li>
      <div class="timeline-marker" aria-hidden="true">
        <span>{String(index + 1).padStart(2, '0')}</span>
      </div>
      <div class="timeline-copy">
        <p>{item.mark}</p>
        <h3>{item.title}</h3>
        <p>{item.text}</p>
      </div>
    </li>
  ))}
</ol>
